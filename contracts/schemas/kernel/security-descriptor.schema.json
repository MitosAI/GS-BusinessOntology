{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/kernel/security-descriptor.schema.json",
  "title": "Security Descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "classification": {"type": ["string", "null"]},
    "policy_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_acl_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "allowed_principals_or_scopes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "denied_principals_or_scopes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "property_restrictions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_restrictions": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "required": ["policy_refs", "source_acl_refs"]
}
