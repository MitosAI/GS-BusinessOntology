{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/kernel/assessment.schema.json",
  "title": "Assessment",
  "allOf": [
    {"$ref": "./canonical-resource.schema.json"},
    {
      "type": "object",
      "properties": {
        "assessment_type": {"type": "string", "minLength": 1},
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "./canonical-ref.schema.json"}
        },
        "assessment_result": {},
        "assessor_ref": {
          "oneOf": [
            {"$ref": "./canonical-ref.schema.json"},
            {"type": "null"}
          ]
        },
        "method_ref": {"type": ["string", "null"]},
        "assessment_status": {
          "type": "string",
          "enum": ["draft", "issued", "reviewed", "withdrawn", "superseded"]
        }
      },
      "required": ["assessment_type", "subject_refs", "assessment_result", "assessment_status"]
    }
  ]
}
