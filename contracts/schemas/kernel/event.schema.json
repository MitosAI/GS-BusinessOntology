{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/kernel/event.schema.json",
  "title": "Event",
  "allOf": [
    {"$ref": "./canonical-resource.schema.json"},
    {
      "type": "object",
      "properties": {
        "event_type": {"type": "string", "minLength": 1},
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "./canonical-ref.schema.json"}
        },
        "participant_refs": {
          "type": "array",
          "items": {"$ref": "./canonical-ref.schema.json"}
        },
        "event_summary": {"type": ["string", "null"]}
      },
      "required": ["event_type", "subject_refs", "participant_refs"]
    }
  ]
}
