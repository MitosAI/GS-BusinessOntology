{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/evidence/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "observation_id": {"type":"string","minLength":1},
    "observation_type": {"type":"string","minLength":1},
    "subject_text": {"type":["string","null"]},
    "normalized_value": {},
    "source_evidence_ids": {"type":"array","minItems":1,"items":{"type":"string"}},
    "context_refs": {"type":"array","items":{"$ref":"../kernel/canonical-ref.schema.json"}},
    "extraction_method": {"type":"string","enum":["deterministic","model","human","hybrid"]},
    "extractor_version": {"type":["string","null"]},
    "confidence": {"type":["number","null"],"minimum":0,"maximum":1},
    "explicit_or_inferred": {"type":"string","enum":["explicit","inferred","unknown"]},
    "observed_effective_time": {"$ref":"../kernel/effective-time.schema.json"},
    "security": {"$ref":"../kernel/security-descriptor.schema.json"}
  },
  "required": ["observation_id","observation_type","source_evidence_ids","extraction_method","explicit_or_inferred","security"]
}
