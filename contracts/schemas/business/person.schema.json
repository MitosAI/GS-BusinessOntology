{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/person.schema.json",
  "title": "Person",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "Person"},
        "model_owner": {"const": "business_reality"},
        "preferred_name": {"type": "string", "minLength": 1},
        "full_name": {"type": ["string", "null"]},
        "primary_contact_methods": {
          "type": "array",
          "items": {"type": "string"}
        },
        "external_identifiers": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "required": ["preferred_name"]
    }
  ]
}
