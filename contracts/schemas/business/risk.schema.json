{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/risk.schema.json",
  "title": "Risk",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "Risk"},
        "model_owner": {"const": "executive_judgment"},
        "risk_title": {"type": "string", "minLength": 1},
        "risk_type": {"type": ["string", "null"]},
        "scope_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "../kernel/canonical-ref.schema.json"}
        },
        "risk_owner_ref": {
          "oneOf": [
            {"$ref": "../kernel/canonical-ref.schema.json"},
            {"type": "null"}
          ]
        },
        "risk_status": {
          "type": "string",
          "enum": ["identified", "assessed", "accepted", "mitigating", "monitoring", "realized", "closed", "unknown"]
        },
        "likelihood_assessment_ref": {
          "oneOf": [
            {"$ref": "../kernel/canonical-ref.schema.json"},
            {"type": "null"}
          ]
        },
        "impact_assessment_ref": {
          "oneOf": [
            {"$ref": "../kernel/canonical-ref.schema.json"},
            {"type": "null"}
          ]
        }
      },
      "required": ["risk_title", "scope_refs", "risk_status"]
    }
  ]
}
