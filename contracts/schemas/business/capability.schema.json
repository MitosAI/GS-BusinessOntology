{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/capability.schema.json",
  "title": "Capability",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {"type":"object","properties":{
      "type":{"const":"Capability"},
      "model_owner":{"const":"capability"},
