{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/organization.schema.json",
  "title": "Organization",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "Organization"},
        "model_owner": {"const": "business_reality"},
        "canonical_name": {"type": "string", "minLength": 1},
        "organization_kind": {"type": ["string", "null"]},
        "website_domain": {"type": ["string", "null"]},
        "external_identifiers": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "operational_status": {
          "type": ["string", "null"],
          "enum": [null, "active", "inactive", "dissolved", "unknown"]
        }
      },
      "required": ["canonical_name"]
    }
  ]
}
