{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/certification.schema.json",
  "title": "Certification",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {"type":"object","properties":{
      "type":{"const":"Certification"},
      "model_owner":{"const":"business_reality"},
      "canonical_name":{"type":"string","minLength":1},
      "issuer_ref":{"oneOf":[{"$ref":"../kernel/canonical-ref.schema.json"},{"type":"null"}]},
      "holder_ref":{"$ref":"../kernel/canonical-ref.schema.json"},
      "identifier":{"type":["string","null"]},
      "effective_on":{"type":["string","null"],"format":"date"},
      "expires_on":{"type":["string","null"],"format":"date"},
      "status":{"type":"string","enum":["pending","active","expired","suspended","revoked","unknown"]}
    },"required":["canonical_name","holder_ref","status"]}
  ]
}
