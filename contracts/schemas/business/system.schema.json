{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/system.schema.json",
  "title": "System",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {"type":"object","properties":{
