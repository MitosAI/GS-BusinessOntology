{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gensigma.example/contracts/business/solicitation.schema.json",
  "title": "Solicitation",
  "allOf": [
    {"$ref": "../kernel/canonical-resource.schema.json"},
    {"type":"object","properties":{
      "type":{"const":"Solicitation"},
      "model_owner":{"const":"business_reality"},
      "canonical_name":{"type":"string","minLength":1},
      "issuer_ref":{"$ref":"../kernel/canonical-ref.schema.json"},
      "identifier":{"type":["string","null"]},
      "status":{"type":"string","enum":["draft","open","amended","closed","cancelled","awarded","unknown"]},
      "response_due_at":{"type":["string","null"],"format":"date-time"}
    },"required":["canonical_name","issuer_ref","status"]}
  ]
}
